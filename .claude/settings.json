{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": [
    "**/references/*/CLAUDE.md",
    "**/references/*/**/CLAUDE.md",
    "**/references/*/AGENTS.md",
    "**/references/*/**/AGENTS.md"
  ],
  "enabledPlugins": {
    "dw-solo@dw-solo-skills": false,
    "dw-solo-setup@dw-solo-skills": false,
    "dw-solo-extras@dw-solo-skills": false
  },
  "permissions": {
    "allow": [
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git worktree add *)",
      "Bash(pnpm check)",
      "Bash(pnpm references:sync *)",
      "Bash(pnpm references:sync)",
      "Bash(rtk gh pr checks *)",
      "Bash(rtk gh pr create *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh pr edit *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk gh pr merge *)",
      "Bash(rtk gh pr status *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk git commit *)",
      "Bash(rtk git push *)",
      "Bash(rtk git push)",
      "Bash(rtk git worktree add *)",
      "Bash(rtk pnpm check)",
      "Bash(rtk pnpm references:sync *)",
      "Bash(rtk pnpm references:sync)"
    ]
  }
}
