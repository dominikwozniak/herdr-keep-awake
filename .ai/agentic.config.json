{
  "$schema": "../node_modules/dw-sdlc/config/agentic.config.schema.json",
  "version": 1,
  "packageManagers": { "node": "pnpm" },
  "guardrails": {
    "forcePush": "lease",
    "envFiles": { "policy": "git" },
    "protectedBranches": ["main"]
  },
  "commit": {
    "convention": "conventional",
    "trailer": "Co-Authored-By"
  },
  "pr": { "reviewFull": ["scripts.bootstrap", "toolchain.supply-chain"] },
  "worktree": { "setup": ["pnpm install", "pnpm references:sync"] },
  "gate": {
    "steps": ["pnpm exec vp check", "pnpm references:setup --check", "pnpm exec vp test"],
    "checks": {
      "run": [{ "name": "agents-check", "command": "node scripts/agents-check.ts" }],
      "primitives": { "roots": ["mods", "scripts", "tools"] },
      "agents-map": true,
      "markdown-budget": true,
      "markdown-refs": true,
      "temporal-language": true,
      "decision-records": { "dirs": ["docs/decisions"], "fields": ["date", "touches", "amended-by"] },
      "routed-docs": true,
      "disable-directives": true,
      "pinned-actions": true,
      "file-size-ratchet": true,
      "comment-budget": true
    }
  }
}
